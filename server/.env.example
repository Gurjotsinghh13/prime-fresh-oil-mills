# Prime Fresh Oil Mills - Backend Environment Configuration

# Server Port (default 3000)
PORT=3000

# Google Gemini API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Gemini Model (gemini-2.5-flash is fast, reliable, and recommended)
GEMINI_MODEL=gemini-2.5-flash

# Frontend Origin for CORS (comma separated for multiple origins)
FRONTEND_ORIGIN=http://localhost:8000,http://127.0.0.1:8000
