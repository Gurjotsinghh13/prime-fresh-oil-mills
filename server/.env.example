# Prime Fresh Oil Mills - Backend Environment Configuration

# Server Port (default 3000)
PORT=3000

# Google Gemini API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Gemini Model (gemini-3.5-flash-lite / gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# Allowed Frontend Origins for CORS (comma separated for multiple origins in production)
ALLOWED_ORIGIN=http://localhost:8000,http://127.0.0.1:8000,https://your-production-domain.com

# Node Environment ('development' or 'production')
NODE_ENV=production

